// Cloudflare Worker: serves the PWA from static assets AND runs a Worker script (worker/index.ts)
// for /api/* and the scheduled data pipeline. Only /api/* executes Worker code; every other
// request is a free static-asset hit.
// Deploy with `npm run deploy:worker` (Cloudflare Workers Builds "Deploy command" and deploy.yml):
// it refuses assets-only uploads and attaches runtime vars/secrets. See DEPLOYMENT.md §4b.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aour",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routing: unknown paths serve index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // One bounded pipeline tick every 15 minutes (enrichment). Market discovery with Overture
  // runs in GitHub Actions (.github/workflows/discovery.yml) because it needs DuckDB.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Per-IP limit for /api/geocode (Workers Rate Limiting binding).
  "ratelimits": [{ "name": "GEOCODE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Keep variables set in the Cloudflare dashboard (e.g. SUPABASE_URL) across deploys;
  // without this, `wrangler deploy` removes any plain variable not listed below. Secrets are always kept.
  "keep_vars": true,
  "vars": {
    "PIPELINE_ENABLED": "true",
    "WORKER_DISCOVERY": ""
  },
  "observability": { "enabled": true }
}
