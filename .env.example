# Copy to .env.local for local development. Never commit real values.
# Leave both Supabase values empty to run Aour in on-device DEMO mode (no backend needed).

# Public Supabase project URL + anon (publishable) key. These are safe to ship to the browser:
# all access control is enforced by Postgres row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show "Sign in with Apple" (requires Apple provider configured in Supabase Auth).
VITE_ENABLE_APPLE_SIGNIN=false

# Public site URL used to build share links and auth redirects (no trailing slash).
VITE_SITE_URL=http://localhost:5173

# Map style (MapLibre style JSON URL). Default: OpenFreeMap "positron" (free, no key).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional: Cloudflare Web Analytics site token (free, cookie-free).
VITE_CF_ANALYTICS_TOKEN=

# NEVER put the Supabase service_role key or database password in any VITE_ variable.
